{
  "name": "after-hours",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @after-hours/server --filter @after-hours/mobile run dev",
    "dev:server": "pnpm --filter @after-hours/server run dev",
    "dev:web": "pnpm --filter @after-hours/mobile run dev",
    "dev:ios": "pnpm --filter @after-hours/mobile run ios",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present run test",
    "format:check": "prettier --check .",
    "companions:schema": "pnpm --filter @after-hours/companions run schema"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
