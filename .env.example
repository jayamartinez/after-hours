# After Hours environment. Copy to `.env` (git-ignored) and fill in what you need.
# Placeholders only, never commit real values. See docs/architecture.md, "Environment variables".
# Optional variables are marked (optional); unset optional features hide themselves.

# --- Server (apps/server) ---------------------------------------------------
# (optional) Default 8787.
PORT=8787
# (optional) Public origin used to build private-asset URLs. Default: the request's own origin.
PUBLIC_SERVER_URL=
# (optional) Comma-separated browser origins allowed by CORS. Default: http://localhost:8081 (Expo web).
CORS_ORIGINS=http://localhost:8081
# (optional) Image override manifest, relative to the repo root. See docs/image-overrides.md.
COMPANION_ASSET_MANIFEST=config/companion-assets.local.json
# (optional) The manifest itself as JSON, for hosts without config files (Vercel). Wins over
# COMPANION_ASSET_MANIFEST; every `src` must be an https:// URL (e.g. Vercel Blob).
COMPANION_ASSETS_JSON=
# (optional) Directory served at /assets/private for relative manifest `src` values (git-ignored).
PRIVATE_ASSETS_DIR=private-assets
# (optional) Character overrides merged onto the presets. See docs/companions.md.
COMPANIONS_CONFIG=config/companions.local.json
# (optional) Local character editor at /dev/companions (localhost only). Never enable on a deployed server.
DEV_EDITOR=false
# (optional) Default info.
LOG_LEVEL=info

# (optional) development | production. Outside production, CORS also allows any localhost port.
NODE_ENV=development

# --- Database and sessions (D-022; Docker never required) -----------------------
# (optional) Hosted Postgres: the Supabase *session pooler* URI. Unset: local PGlite in PGLITE_DIR.
# After setting it, run `pnpm db:migrate`.
DATABASE_URL=
# (optional) Local PGlite data directory (git-ignored). Default local-data/pglite.
PGLITE_DIR=local-data/pglite
# Signs anonymous session tokens; 32+ characters. Required with DATABASE_URL.
# Unset with PGlite: generated once into local-data/session-secret.
SESSION_SECRET=

# --- Chat providers (needed from Milestone 3) ---------------------------------
CHAT_PRIMARY_PROVIDER=anthropic
# Chat model for demo Plus subscribers.
CHAT_PRIMARY_MODEL=claude-opus-5-5
# (optional) Chat model for free users. Default claude-sonnet-5-5.
CHAT_FREE_MODEL=claude-sonnet-5-5
# (optional) Reasoning effort for chat replies: low | medium | high. Default low.
CHAT_EFFORT=low
ANTHROPIC_API_KEY=<anthropic-api-key>
# (optional) OpenAI-compatible fallback provider.
CHAT_FALLBACK_BASE_URL=
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_MODEL=
# (optional) Cheap model for memory extraction and the personality eval judge.
MEMORY_MODEL=claude-haiku-5-5
# (optional) Local OpenAI-compatible model server, selected explicitly (never an automatic fallback).
LOCAL_LLM_BASE_URL=
# (optional) Embeddings for memory retrieval. Unset: keyword + recency retrieval.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=

# --- Media and tools (optional; features hide when unset) --------------------
IMAGE_PROVIDER=
IMAGE_API_KEY=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
# (optional) Per-companion TTS voice ids.
ROY_TTS_VOICE_ID=
ROYA_TTS_VOICE_ID=
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
# (optional) Default 2.
MAX_TOOL_CALLS_PER_TURN=2

# --- Limits (optional; required for a public demo) ---------------------------
# (optional) Chat messages per user per minute. Default 20.
RATE_LIMIT_PER_MIN=20
DAILY_TOKEN_BUDGET=
DAILY_IMAGE_BUDGET=
DAILY_AUDIO_SECONDS=
# (optional) Estimated provider spend across everyone per UTC day; past it chat pauses. Default 25.
GLOBAL_DAILY_SPEND_CAP_USD=25
# (optional) Estimated spend per network (hashed IP / IPv6 /64), ever. Survives account deletion. Default 3.
NETWORK_LIFETIME_CAP_USD=3
# (optional) New anonymous accounts per network per UTC day. Default 10.
SESSIONS_PER_NETWORK_PER_DAY=10
# (optional) true behind a reverse proxy: read the client address from X-Forwarded-For. Default false.
TRUST_PROXY=false
# (optional) true: chat sends return 503.
KILL_SWITCH=false
# (optional) false: companions cannot search the web, read shared links, or share found
# pictures. Default true; capped at 20 lookups per user per day (100 with demo Plus).
WEB_ACCESS=true

# --- iMessage bridge (optional) ----------------------------------------------
# Server side: comma-separated bridge tokens. Unset: bridge API disabled.
BRIDGE_TOKENS=
# Bridge process side.
BRIDGE_SERVER_URL=http://localhost:8787
BRIDGE_TOKEN=
BRIDGE_POLL_MS=3000

# --- Mobile app (apps/mobile) -------------------------------------------------
# EXPO_PUBLIC_* values are PUBLIC: they are inlined into the app bundle.
# Expo reads these from apps/mobile/.env (or your shell), not from this root file.
# On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:8787.
EXPO_PUBLIC_API_URL=http://localhost:8787
# (optional) Show the dev character editor route (/dev/companions). Needs DEV_EDITOR=true on the server.
EXPO_PUBLIC_DEV_EDITOR=false
