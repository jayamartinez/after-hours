{
  "title": "After Hours character config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "Immutable slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "age": {
      "type": "integer",
      "minimum": 21,
      "maximum": 9007199254740991
    },
    "pronouns": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. \"he\""
        },
        "object": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. \"him\""
        },
        "possessive": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. \"his\""
        }
      },
      "required": [
        "subject",
        "object",
        "possessive"
      ],
      "additionalProperties": false
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "statusLine": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "Fictional place"
    },
    "locationShort": {
      "type": "string",
      "minLength": 1,
      "description": "Short place label for status lines, e.g. \"South Calder\""
    },
    "blurb": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences for discovery cards and the cast list"
    },
    "tint": {
      "type": "string",
      "enum": [
        "window",
        "lamplight"
      ]
    },
    "bio": {
      "type": "string",
      "minLength": 1,
      "description": "Short; profile \"About\""
    },
    "backstory": {
      "type": "string",
      "minLength": 1
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chips": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "talkStyle": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Profile \"How they talk\" chips"
    },
    "meters": {
      "type": "object",
      "properties": {
        "banter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "pace": {
          "type": "string",
          "enum": [
            "easy",
            "quick",
            "instant"
          ]
        }
      },
      "required": [
        "banter",
        "depth",
        "pace"
      ],
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "badge": {
          "type": "string",
          "minLength": 1,
          "description": "Pill next to the name, e.g. \"AI PARODY\""
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "One short line, shown once in the profile footer"
        }
      },
      "required": [
        "badge",
        "note"
      ],
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "properties": {
        "traits": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "Behavioral instructions for the system prompt, second person"
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Character-specific do-nots. The app-level safety preamble always applies too."
        }
      },
      "required": [
        "traits",
        "instructions",
        "boundaries"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "casing": {
          "type": "string",
          "enum": [
            "lower",
            "sentence"
          ]
        },
        "bubbleLength": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "burst": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Bubbles per turn, [min, max]"
        },
        "emojiRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "questionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flirtation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0 none, 1 light, 2 playful, 3 bold (always PG-13)"
        },
        "roast": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0 none, 1 gentle, 2 teasing, 3 blunt (excuses and ideas only)"
        }
      },
      "required": [
        "casing",
        "bubbleLength",
        "burst",
        "emojiRate",
        "questionRate",
        "flirtation",
        "roast"
      ],
      "additionalProperties": false
    },
    "examples": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string",
                "minLength": 1
              },
              "companion": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Reply bubbles"
              }
            },
            "required": [
              "companion"
            ],
            "additionalProperties": false
          },
          "description": "Few-shot exchanges for the prompt"
        },
        "starters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Conversation starters / quick replies"
        },
        "signatureLines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "messages",
        "starters",
        "signatureLines"
      ],
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "Short form of the description for compact rows, e.g. \"Fast, bright tenor\""
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "voiceId": {
          "type": "string",
          "minLength": 1
        },
        "voiceIdEnv": {
          "description": "Name of the env var holding the TTS voice id",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "required": [
        "description",
        "summary"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxRetrieved": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "enabled",
        "focus",
        "maxRetrieved"
      ],
      "additionalProperties": false
    },
    "proactive": {
      "type": "object",
      "properties": {
        "enabledByDefault": {
          "type": "boolean"
        },
        "quietHours": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "maxPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "openers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "enabledByDefault",
        "quietHours",
        "maxPerDay",
        "openers"
      ],
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "properties": {
        "spotlightCta": {
          "type": "string",
          "minLength": 1
        },
        "revealHeadline": {
          "type": "string",
          "minLength": 1
        },
        "revealSubline": {
          "type": "string",
          "minLength": 1
        },
        "revealCta": {
          "type": "string",
          "minLength": 1,
          "description": "Reveal screen primary button, e.g. \"Say hi\""
        },
        "matchReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "firstMessage": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Opening bubbles"
        },
        "profileSections": {
          "type": "object",
          "properties": {
            "about": {
              "type": "string",
              "minLength": 1
            },
            "talks": {
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "type": "string",
              "minLength": 1
            },
            "remembers": {
              "type": "string",
              "minLength": 1
            },
            "photos": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "about",
            "talks",
            "voice",
            "remembers",
            "photos"
          ],
          "additionalProperties": false
        },
        "voiceLabel": {
          "type": "string",
          "minLength": 1
        },
        "sampleOpener": {
          "type": "string",
          "minLength": 1,
          "description": "Example opening line shown on discovery (\"He might open with\")"
        },
        "chatLocation": {
          "description": "Short fictional place for the chat header status, e.g. \"South Calder\"",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "spotlightCta",
        "revealHeadline",
        "revealSubline",
        "revealCta",
        "matchReasons",
        "firstMessage",
        "profileSections",
        "voiceLabel",
        "sampleOpener"
      ],
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "look": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "style",
        "look"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$",
              "description": "Bundled default image key, e.g. \"roy/hero\""
            },
            "focal": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "asset",
            "focal",
            "alt"
          ],
          "additionalProperties": false,
          "description": "3:4"
        },
        "avatar": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$",
              "description": "Bundled default image key, e.g. \"roy/hero\""
            },
            "focal": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "asset",
            "focal",
            "alt"
          ],
          "additionalProperties": false,
          "description": "1:1"
        },
        "gallery": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "asset": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$",
                  "description": "Bundled default image key, e.g. \"roy/hero\""
                },
                "focal": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "asset",
                "focal",
                "alt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "asset": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$",
                  "description": "Bundled default image key, e.g. \"roy/hero\""
                },
                "focal": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "asset",
                "focal",
                "alt"
              ],
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Two 4:5 images"
        }
      },
      "required": [
        "hero",
        "avatar",
        "gallery"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "age",
    "pronouns",
    "tagline",
    "statusLine",
    "location",
    "locationShort",
    "blurb",
    "tint",
    "bio",
    "backstory",
    "interests",
    "chips",
    "talkStyle",
    "meters",
    "disclosure",
    "personality",
    "style",
    "examples",
    "voice",
    "memory",
    "proactive",
    "copy",
    "appearance",
    "images"
  ],
  "additionalProperties": false
}
